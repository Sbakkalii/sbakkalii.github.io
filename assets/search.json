---
# Index for the Ctrl+K search palette, generated at build time.
sitemap: false
layout: null
---
{%- assign items = "" | split: "" -%}
[
  {%- assign pages = site.pages | where_exp: "p", "p.title" | where_exp: "p", "p.url != '/404.html'" -%}
  {%- for p in pages -%}
  {
    "type": "Page",
    "title": {{ p.title | strip_html | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "text": {{ p.description | default: p.lede | default: "" | strip_html | jsonify }}
  },
  {%- endfor -%}
  {%- for prod in site.data.products.products -%}
  {
    "type": "Product",
    "title": {{ prod.name | jsonify }},
    "url": {{ '/products/' | append: '#' | append: prod.id | relative_url | jsonify }},
    "text": {{ prod.tagline | append: " " | append: prod.pitch | strip | jsonify }}
  },
  {%- endfor -%}
  {%- assign sections = "bottleneck|The statelessness bottleneck,map|Capability map (Fig. 2),lineage|Representation lineage (Tables I–II),state|State tuple and lifecycle (Algorithm 1),reconcile|Reconciliation outcomes,contamination|Contamination bound (Theorem III.4),substrates|Memory substrates (Table III),audit|Statefulness audit (Table IV),harness|Longitudinal harness and five metrics,forgetting|Five-level verifiable forgetting,deployment|Deployment: domains and constraints,agenda|Research agenda,limitations|Limitations of the paper" | split: "," -%}
  {%- for s in sections -%}
  {%- assign parts = s | split: "|" -%}
  {
    "type": "Paper",
    "title": {{ parts[1] | jsonify }},
    "url": {{ '/research/persistent-state/' | append: '#' | append: parts[0] | relative_url | jsonify }},
    "text": "Amnesia by Design, Memory by Necessity"
  },
  {%- endfor -%}
  {%- assign pubs = site.publications | sort: "date" | reverse -%}
  {%- for p in pubs -%}
  {
    "type": "Publication",
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "text": {{ p.authors | append: " · " | append: p.venue_short | jsonify }},
    "year": "{{ p.date | date: '%Y' }}"
  }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
]
